# mock | rest — controls whether MSW intercepts API calls or requests hit a real NestJS backend.
NEXT_PUBLIC_API_MODE=mock

# Base URL the repository layer targets. Same contract in both modes; MSW intercepts
# this path in "mock" mode, a real NestJS instance answers it in "rest" mode.
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Session cookie name + a mock signing secret (mock-auth only — never a real secret).
NEXT_PUBLIC_SESSION_COOKIE_NAME=gymos_session
MOCK_SESSION_SECRET=dev-only-mock-secret-change-me
